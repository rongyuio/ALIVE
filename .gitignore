# libmpv 运行库：116MB，不进仓库。make deps 按 sha256 下到用户缓存。
# 上游自己也这么做（internal/nativelib/nativelib.go:355 落到 <cache>/mygo/natives/）。
/third_party/mpv/bin/libmpv-2.dll

# 打包产物与开发缓存
/build/
/.mygo/
mygo_windows_*.syso

# `go build .` 会在仓库根产出同名二进制
/ALIVE
/ALIVE.exe
# go build ./cmd/<工具> 在仓根产出的二进制
/alive-*.exe

# 本地临时文件
/.task/
/.tmp/

# 探针不进仓库：要连公网、要真实流、跑不进 make check 的测试放 .tmp/probes/ 下，
# 需要时拷回对应包。见 AGENTS.md「测试与验证」。
*_probe_test.go
zz_*_test.go

# 更新签名私钥：任何情况下都不进仓库。公钥在 mygo.json 的 updates.publicKey，
# 私钥按 doc/decisions/0015-self-update.md 放在仓库外，构建时走环境变量。
mygo-update.key

# README 等 owner 验收后再入库。
/README.md

